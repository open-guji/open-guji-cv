venv/
__pycache__/
# .claude/ 曾被整体忽略，但仓库里其实一直跟踪着 23 个文件（settings、doc、
# scripts）——只有**新增**的文件会被静默漏掉：pipeline_handbook.md 写完
# 提交时就这么丢过一次。这里是项目的设计文档与协作约定，本来就该入库。
dist/
build/
*.egg-info/
# 异体字关系层的下载缓存（Unihan.zip / cjkvi / yitizi 原始文件，
# 可由 scripts/build_variants.py 重新下载；产物 variants.json 入库）
config/variants/cache/
config/gloss/cache/

# 字形库 SQLite 索引（可由 glyph_store/ 重建，不入版本控制）
glyph_store/glyphdb.sqlite
*.sqlite-journal

# output/、data_full/ 曾经 gitignore，但容器重置会把它们连同耗时的
# 下载/切分/聚类结果一起清空（archive.org 常被组织策略拦截，重下不一定
# 能立刻做到）。改为入库，代价是仓库变大，但避免每次重来。
# 唯一仍不入库的是可从 glyph_store/ 一键重建的 SQLite 索引（见上），
# 以及聚类的 HOG 特征矩阵缓存——纯 phase4_chars 的确定性函数，一条
# `cluster` 命令几分钟重算，体积却单册就上百 MB，超过 GitHub 单文件
# 100MB 硬限（vol02 首次推送即被拒）。
**/phase5_clusters/features*.npz
corpus/external/.general_lm_cache.*

# 自评抽样的中间件：图块由 scripts/sample_live.py 现算可重建，
# 判读结论的真源在 open-guji-dataset 的 self_assess_*.json 分片里。
# sample.json 与 sheets/ 入库（便于回看当轮抽到了哪些格）。
output/self_assess_*/patches/
output/self_assess_*/baseline.json
output/self_assess_*/judged_ids.txt

# Step2 金标标注页的 HTML 快照——802KB 全是矫正图 data URI，
# `scripts/build_column_warp_review.py` 可确定性再生，不入库（卡片 id 另存 jsonl）
output/column_warp_review.html

# 上下版框标注页的 HTML 快照——同上，`scripts/build_column_border_review.py` 可再生
output/column_border_review.html

# Step2→Step3 交接的列图：131MB，但**由已入库的 output/<book>/step2_columns/
# 确定性再生**，`python scripts/export_step3_input.py --book <book> --tier gate`
# 几秒钟跑完（clean_column 每页 0.03s）。跟 step2_columns 不一样——那个要跑
# Step1 的 detect_borders（每页 1.8s，全书 5 分钟），值得入库；这个不值得。
# manifest.json 照常入库：准入裁决、period/ref_w、逐页拒绝理由都在里面。
output/*/step3_input/*/

# ── 四个抽象（console_architecture.md）──────────────────────────────
# 数值产物本地工作副本、图像缓存、控制台任务记录：都能由 原图 × 代码 现算/重跑，
# 不入库；要冻结某版产物用 `guji pin`（进 pins/）。新 venv 用 uv 建在 .venv/。
# 前导 / 锚定到仓库根：否则 `products/` 会连源码包 open_guji_cv/products/ 一起忽略
/products/
/cache/
/runs/
/.venv/
# 审查批次登记的本地副本（真源随数据集仓走；控制台用 GUJI_BATCHES_DIR 指定）
/review/batches/

# 临时目录（2026-09-05：git add -A 误带过一次）
output/_grid_test/
output/tmp*/

# 对勘报告（scripts/build_collation_report.py 产物，可再生；分享件在 overview）
output/collation_*

# 字形库 SQLite：83MB 二进制，每次提交近乎多存一份完整副本（历史里 63 版 = 3.19 GiB）。
# 真源是 output/glyph_store/（glyph-db export 导出，进版本控制），
# 本文件由 glyph-db rebuild 重建 —— 与库内 README「sqlite 是可重建索引，不进版本控制」一致。
output/glyph.db
output/glyph.db-journal
output/glyph.db-wal
output/glyph.db-shm
