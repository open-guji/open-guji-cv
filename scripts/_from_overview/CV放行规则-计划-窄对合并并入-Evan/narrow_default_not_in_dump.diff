+    关着、或页上没有窄对时，产物逐字节不变。触发页的 `expected_cols` 记成少一列，闸读它。
+    缺省值（关）不进 dump，没开的书 `params_hash` 与加字段前逐位相同。"""
+
+    @model_serializer(mode="wrap")
+    def _drop_off_merge_narrow_pair(self, handler):
+        """关着的 `merge_narrow_pair` 不进 dump（照 `SeedAdmitParams._drop_off_rare`）。"""
+        d = handler(self)
