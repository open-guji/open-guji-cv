[{"id": "vol02:188:6:5", "group": "ry", "left": "說者也其易筮通變凡五篇一日卜筮二日立卦三", "right": "九六四日衍數五日命蓍亦多自岀新意不主舊法", "corpus": "日", "system": "曰", "via": "haiku", "why": "disagree_v2"}, {"id": "vol02:188:6:9", "group": "ry", "left": "易筮通變凡五篇一日卜筮二日立卦三日九六四", "right": "衍數五日命蓍亦多自岀新意不主舊法白雲霽道", "corpus": "日", "system": "曰", "via": "haiku", "why": "disagree_v2"}, {"id": "vol02:188:6:13", "group": "ry", "left": "凡五篇一日卜筮二日立卦三日九六四日衍數五", "right": "命蓍亦多自岀新意不主舊法白雲霽道藏目錄載", "corpus": "日", "system": "曰", "via": "haiku", "why": "disagree_v2"}, {"id": "vol04:144:1:9", "group": "ry", "left": "後用九之前故", "right": "中天其象藏於互體而義發見於文王周公孔子之", "corpus": "曰", "system": "日", "via": "haiku", "why": "disagree_v2"}, {"id": "vol06:25:6:18", "group": "ry", "left": "通漢晉唐宋爲一然大㫖主理不主數故於卦氣値", "right": "及虞翻半象兩象等說皆排抑之是仍一家之學不", "corpus": "曰", "system": "日", "via": "haiku", "why": "disagree_v2"}, {"id": "vol07:115:4:13", "group": "ry", "left": "所考辨召誥土中說一條引周禮日東則景夕多風", "right": "西則景朝多陰謂蔡傳所引王氏之說誤謂景朝多", "corpus": "日", "system": "曰", "via": "haiku", "why": "disagree_v2"}, {"id": "vol07:126:9:21", "group": "ry", "left": "嘗錄得以藏於家顧炎武日知錄曰按宋歐陽永叔", "right": "", "corpus": "日", "system": "曰", "via": "L1", "why": "disagree_v2"}, {"id": "vol08:63:1:21", "group": "ry", "left": "見故曰知新如解堯典命羲和數節則謂後世", "right": "晷爲定分至之要而舉南北極及歲周歲差之法皆", "corpus": "日", "system": "曰", "via": "haiku", "why": "disagree_v2"}, {"id": "vol09:50:9:15", "group": "ry", "left": "賜諡文端事迹具宋史儒林傳傳稱溪字肖望黃震", "right": "鈔亦同而沈光", "corpus": "曰", "system": "日", "via": "L1", "why": "disagree_v2"}, {"id": "vol02:23:6:16", "group": "rr", "left": "不雜於術數者弼康伯深爲有功祖尚虛無使易竟", "right": "於老莊者弼康伯亦不能無過瑕瑜不掩是其定評", "corpus": "人", "system": "入", "via": "haiku", "why": "disagree_v2"}, {"id": "vol08:14:3:17", "group": "rr", "left": "之射卽無病之呻葦籥指㸃虛實筆光開洞眞可引", "right": "心氣資人聰明其經如經星之左旋其緯如緯星之", "corpus": "人", "system": "入", "via": "haiku", "why": "disagree_v2"}]